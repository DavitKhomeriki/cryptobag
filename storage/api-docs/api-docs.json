{
    "openapi": "3.0.0",
    "info": {
        "title": "CryptoBag API",
        "description": "API documentation for CryptoBag.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Application"
        }
    ],
    "paths": {
        "/api/bitgo/webhook": {
            "post": {
                "tags": [
                    "Internal - BitGo Webhooks"
                ],
                "summary": "Receive BitGo transfer webhook",
                "description": "Internal provider callback used by BitGo. This endpoint is documented for developers only and is not intended for merchant clients.",
                "operationId": "receiveBitGoWebhook",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "type"
                                ],
                                "properties": {
                                    "type": {
                                        "description": "BitGo webhook event type. Transfer events include wallet and transfer identifiers.",
                                        "type": "string",
                                        "example": "transfer"
                                    },
                                    "wallet": {
                                        "description": "BitGo wallet identifier. Required when type is transfer.",
                                        "type": "string",
                                        "example": "wallet-123",
                                        "maxLength": 255
                                    },
                                    "transfer": {
                                        "description": "BitGo transfer identifier. Required when type is transfer.",
                                        "type": "string",
                                        "pattern": "^[a-zA-Z0-9_-]+$",
                                        "example": "transfer-123",
                                        "maxLength": 255
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Webhook acknowledged",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "received": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid webhook payload or transfer mismatch"
                    },
                    "500": {
                        "description": "BitGo verification failed"
                    }
                }
            }
        },
        "/api/v1/bitgo/payment": {
            "post": {
                "tags": [
                    "Payments"
                ],
                "summary": "Create an external BitGo payment",
                "operationId": "createExternalPayment",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "description": "Unique key used to safely retry the same payment request.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "payment-key-123"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "order_id",
                                    "wallet_id",
                                    "passphrase",
                                    "amount",
                                    "address"
                                ],
                                "properties": {
                                    "order_id": {
                                        "type": "integer",
                                        "example": 123
                                    },
                                    "wallet_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "passphrase": {
                                        "type": "string",
                                        "example": "test-only"
                                    },
                                    "amount": {
                                        "type": "string",
                                        "example": "0.00100000"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "merchant-address"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Payment created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "payment_id": {
                                            "type": "string",
                                            "example": "1"
                                        },
                                        "order_id": {
                                            "type": "string",
                                            "example": "123"
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "pending"
                                        },
                                        "amount": {
                                            "type": "string",
                                            "example": "0.00100000"
                                        },
                                        "transfer_id": {
                                            "type": "string",
                                            "example": "transfer-123",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Existing idempotent payment returned"
                    },
                    "400": {
                        "description": "Missing Idempotency-Key header"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Internal - BitGo Webhooks",
            "description": "Provider callbacks used by BitGo. These endpoints are documented for developers only and are not merchant-facing APIs."
        },
        {
            "name": "Payments",
            "description": "Payments"
        }
    ]
}